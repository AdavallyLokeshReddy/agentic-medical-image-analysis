# Copy to .env and edit. Never commit the real .env file.

# --- API (read by backend/main.py and docker/entrypoint.sh) ---
# Comma-separated browser origins allowed to call the API. Never "*".
CORS_ORIGINS=https://adavallylokeshreddy.github.io,http://localhost:3000
# Port the container listens on (hosts such as Cloud Run set this themselves)
PORT=8080

# Max analysis jobs queued or running at once (the model runs one at a time)
JOBS_MAX_PENDING=3

# --- Database (read by backend/database/connection.py) ---
# When set and reachable, analysis-job state is stored in PostgreSQL (jobs/persistence.py). When unset, it stays in memory.
# Local PostgreSQL 16: docker compose up -d postgres  (password in docker-compose.yml is dev-only)
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/agentic_medical_ai

# --- Model runtime ---
# Hugging Face cache location. The image bakes weights into /opt/model-cache.
HF_HOME=/opt/model-cache

# --- PLANNED, not read by any code yet (object storage phase) ---
# OBJECT_STORAGE_ENDPOINT=
# OBJECT_STORAGE_BUCKET=
# OBJECT_STORAGE_ACCESS_KEY=
# OBJECT_STORAGE_SECRET_KEY=
